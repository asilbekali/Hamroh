generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
  LATE
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @unique @db.VarChar(160)
  password  String
  phone     String?  @db.VarChar(30)
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coordinatedEvents Event[]        @relation("EventCoordinator")
  createdEvents     Event[]        @relation("EventCreator")
  createdActivities Activity[]     @relation("ActivityCreator")
  announcements     Announcement[] @relation("AnnouncementAuthor")

  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events     Event[]
  activities Activity[]

  @@map("categories")
}

model Event {
  id                String      @id @default(uuid()) @db.Uuid
  title             String      @db.VarChar(200)
  slug              String      @unique @db.VarChar(220)
  description       String?
  location          String?     @db.VarChar(200)
  coverImage        String?     @map("cover_image")
  startDate         DateTime    @map("start_date")
  endDate           DateTime    @map("end_date")
  registrationLimit Int?        @map("registration_limit")
  status            EventStatus @default(DRAFT)
  isPublished       Boolean     @default(false) @map("is_published")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  categoryId    String? @map("category_id") @db.Uuid
  coordinatorId String? @map("coordinator_id") @db.Uuid
  createdById   String? @map("created_by_id") @db.Uuid

  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coordinator User?     @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  registrations Registration[]

  @@index([status])
  @@index([startDate])
  @@index([categoryId])
  @@map("events")
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(200)
  description String?
  status      ActivityStatus @default(ACTIVE)
  recurrence  RecurrenceType @default(NONE)
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  capacity    Int?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  categoryId  String? @map("category_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  registrations Registration[]

  @@index([status])
  @@index([categoryId])
  @@map("activities")
}

model Participant {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String    @map("full_name") @db.VarChar(120)
  email       String    @unique @db.VarChar(160)
  phone       String?   @db.VarChar(30)
  dateOfBirth DateTime? @map("date_of_birth")
  address     String?   @db.VarChar(255)
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  registrations Registration[]

  @@index([fullName])
  @@map("participants")
}

model Registration {
  id         String             @id @default(uuid()) @db.Uuid
  status     RegistrationStatus @default(PENDING)
  attendance AttendanceStatus   @default(NOT_MARKED)
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  participantId String  @map("participant_id") @db.Uuid
  eventId       String? @map("event_id") @db.Uuid
  activityId    String? @map("activity_id") @db.Uuid

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity    Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventId])
  @@unique([participantId, activityId])
  @@index([status])
  @@map("registrations")
}

model Announcement {
  id        String             @id @default(uuid()) @db.Uuid
  title     String             @db.VarChar(200)
  body      String
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("announcements")
}
