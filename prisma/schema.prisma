generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TRAINER
}

/// Regions of Uzbekistan. Every branch belongs to exactly one of them.
enum Region {
  KARAKALPAKSTAN
  ANDIJAN
  BUKHARA
  FERGANA
  JIZZAKH
  KASHKADARYA
  KHOREZM
  NAMANGAN
  NAVOIY
  SAMARKAND
  SIRDARYA
  SURKHANDARYA
  TASHKENT_REGION
  TASHKENT_CITY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  region    Region
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff         User[]
  participants  Participant[]
  activities    Activity[]
  announcements Announcement[]
  auditEntries  AuditLog[]

  @@index([region])
  @@map("branches")
}

/// Staff accounts that can sign in: super admins, branch admins and trainers.
model User {
  id        String    @id @default(uuid()) @db.Uuid
  username  String    @unique @db.VarChar(60)
  password  String
  fullName  String    @map("full_name") @db.VarChar(120)
  phone     String?   @db.VarChar(30)
  role      Role      @default(ADMIN)
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// Null only for SUPER_ADMIN, who is not tied to a branch.
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdParticipants Participant[]        @relation("ParticipantCreator")
  createdActivities   Activity[]           @relation("ActivityCreator")
  trainedActivities   Activity[]           @relation("ActivityTrainer")
  recordedAttendances Attendance[]         @relation("AttendanceRecorder")
  announcements       Announcement[]       @relation("AnnouncementAuthor")
  assignedTodos       TodoItem[]           @relation("TodoAssignee")
  addedEnrollments    ActivityEnrollment[] @relation("EnrollmentCreator")
  auditEntries        AuditLog[]           @relation("AuditActor")

  @@index([role])
  @@index([branchId])
  @@map("users")
}

/// A person served by a branch. These are the records the "Users" section lists.
model Participant {
  id String @id @default(uuid()) @db.Uuid

  /// Stable, human-facing number — the "№" column. Unlike a row index it does
  /// not move when the list is sorted or paged, so it can be searched on.
  serialNumber Int @unique @default(autoincrement()) @map("serial_number")

  firstName  String   @map("first_name") @db.VarChar(60)
  lastName   String   @map("last_name") @db.VarChar(60)
  middleName String?  @map("middle_name") @db.VarChar(60)
  birthDate  DateTime @map("birth_date") @db.Date
  phone      String   @db.VarChar(30)
  address    String   @db.VarChar(255)
  /// District ("tuman") and neighbourhood ("mahalla"), reported as own columns.
  district   String?  @db.VarChar(120)
  mahalla    String?  @db.VarChar(120)
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  branchId    String  @map("branch_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("ParticipantCreator", fields: [createdById], references: [id], onDelete: SetNull)

  attendances Attendance[]
  enrollments ActivityEnrollment[]

  @@index([branchId])
  @@index([lastName, firstName])
  @@index([createdAt])
  @@map("participants")
}

/// A recurring session, e.g. "Mon/Wed at 13:00, Fri at 16:00".
/// Created empty; participants join later through enrollment or attendance.
model Activity {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(200)
  description String?

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  capacity  Int?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  branchId    String  @map("branch_id") @db.Uuid
  trainerId   String? @map("trainer_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trainer   User?  @relation("ActivityTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The weekly schedule. Each weekday carries its own time and duration.
  slots       ActivitySlot[]
  attendances Attendance[]
  enrollments ActivityEnrollment[]

  @@index([branchId])
  @@index([trainerId])
  @@map("activities")
}

/// One weekday of an activity's weekly schedule, with its own start time —
/// this is what lets Monday run at 13:00 while Friday runs at 16:00.
model ActivitySlot {
  id String @id @default(uuid()) @db.Uuid

  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday         Int
  /// Local start time in 24h "HH:mm" form.
  startTime       String @map("start_time") @db.VarChar(5)
  durationMinutes Int    @map("duration_minutes")

  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// An activity runs at most once per weekday.
  @@unique([activityId, weekday])
  @@index([weekday])
  @@map("activity_slots")
}

/// A participant signed up to an activity. Independent of attendance: being
/// enrolled is membership, attendance is who actually turned up on a date.
model ActivityEnrollment {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  activityId    String  @map("activity_id") @db.Uuid
  participantId String  @map("participant_id") @db.Uuid
  addedById     String? @map("added_by_id") @db.Uuid

  activity    Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  addedBy     User?       @relation("EnrollmentCreator", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([activityId, participantId])
  @@index([participantId])
  @@map("activity_enrollments")
}

/// Links a participant to one dated occurrence of an activity.
model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  activityId    String  @map("activity_id") @db.Uuid
  participantId String  @map("participant_id") @db.Uuid
  recordedById  String? @map("recorded_by_id") @db.Uuid

  activity    Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([activityId, participantId, date])
  @@index([date])
  @@index([participantId])
  @@map("attendances")
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(200)
  body        String
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  authorId String? @map("author_id") @db.Uuid
  /// Null means the announcement targets every branch.
  branchId String? @map("branch_id") @db.Uuid

  author User?   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  todos TodoItem[]

  @@index([status])
  @@index([branchId])
  @@map("announcements")
}

/// A checklist entry inside an announcement, assignable to a branch admin.
model TodoItem {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(200)
  description String?
  status      TodoStatus @default(PENDING)
  position    Int        @default(0)
  dueDate     DateTime?  @map("due_date")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  announcementId String  @map("announcement_id") @db.Uuid
  assigneeId     String? @map("assignee_id") @db.Uuid

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([announcementId])
  @@index([assigneeId])
  @@index([status])
  @@map("todo_items")
}

/// Who did what, and in which branch. Written for every mutating request so a
/// super admin can audit the network without trusting the client.
///
/// The actor's username and role are denormalised on purpose: the entry has to
/// stay readable after the account it describes is renamed or deleted.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Dotted action name, e.g. "activity.create" or "branch.assignStaff".
  action     String  @db.VarChar(80)
  method     String  @db.VarChar(10)
  path       String  @db.VarChar(255)
  entityType String? @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id") @db.VarChar(64)
  /// Short human-readable sentence shown in the log table.
  summary    String? @db.VarChar(500)
  statusCode Int     @map("status_code")

  createdAt DateTime @default(now()) @map("created_at")

  actorId       String? @map("actor_id") @db.Uuid
  actorUsername String? @map("actor_username") @db.VarChar(60)
  actorRole     Role?   @map("actor_role")
  branchId      String? @map("branch_id") @db.Uuid

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([branchId])
  @@index([action])
  @@map("audit_logs")
}
